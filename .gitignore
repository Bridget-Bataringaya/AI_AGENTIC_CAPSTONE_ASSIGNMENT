__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.DS_Store

# Runtime database files. Case history lives under data/memory/ and is
# also covered below; these globs catch stray copies in the working tree.
*.sqlite
*.db
*.sqlite3

# Partial evaluation output from --no-model runs, not a deliverable
docs/evaluation/*.partial.*

# Large generated fixtures are rebuilt by the generator scripts
evidence/traces/*.log

# Retrieval index, rebuilt from knowledge/corpus/ with `python run.py index`
knowledge/index/

# Case history, written locally by workflow runs and never committed
data/memory/

# Run logs, written locally by every run and never committed
data/logs/
