# Model backend. Defaults match the team's Accessible Model Documentation.
PROCURECHECK_MODEL=llama3.1:8b
PROCURECHECK_BASE_URL=http://localhost:11434

# Generation parameters fixed by the Model Selection Note (Sec. 6).
PROCURECHECK_TEMPERATURE=0.0
PROCURECHECK_TOP_P=0.9
PROCURECHECK_MAX_OUTPUT_TOKENS=2048

# Confidence below this routes an item to Requires Human Review.
PROCURECHECK_HUMAN_REVIEW_THRESHOLD=0.85

# Matching strategy: per_item (default) or batch (Prompt Spec v1.0 literal).
PROCURECHECK_STRATEGY=per_item

PROCURECHECK_TIMEOUT_SECONDS=300
PROCURECHECK_SCHEMA_RETRY_LIMIT=1
PROCURECHECK_SNIPPET_MAX_CHARS=400
PROCURECHECK_CONTEXT_TOKENS=16384
