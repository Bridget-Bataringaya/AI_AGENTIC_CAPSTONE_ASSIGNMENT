# Model backend. Defaults match the team's Accessible Model Documentation.
PROCURECHECK_MODEL=llama3.1:8b
PROCURECHECK_BASE_URL=http://localhost:11434

# Generation parameters fixed by the Model Selection Note (Sec. 6).
PROCURECHECK_TEMPERATURE=0.0
PROCURECHECK_TOP_P=0.9
PROCURECHECK_MAX_OUTPUT_TOKENS=2048

# Confidence below this routes an item to Requires Human Review.
PROCURECHECK_HUMAN_REVIEW_THRESHOLD=0.85

# Matching strategy: per_item (default) or batch (Prompt Spec v1.0 literal).
PROCURECHECK_STRATEGY=per_item

# Prompt iteration to run: v2.0 (default) or v1.0. See
# prompts/prompt-version-history.md. v1.0 is kept selectable only so the
# recorded v1.0 baseline can be reproduced; it under-reports missing items.
PROCURECHECK_PROMPT_VERSION=v2.0

# Per-request timeout. Generous by default because a single call on a
# CPU-only machine can take several minutes under prompt v2.0; it is there
# to catch a hung backend, not to bound ordinary slowness.
PROCURECHECK_TIMEOUT_SECONDS=1800
PROCURECHECK_SCHEMA_RETRY_LIMIT=1
PROCURECHECK_SNIPPET_MAX_CHARS=400
PROCURECHECK_CONTEXT_TOKENS=16384

# The second model pass that re-reads each quotation against its requirement,
# with the submission withheld. off reproduces the single-pass baseline.
PROCURECHECK_ADJUDICATE=on

# A check writes a PDF, the report of record. While the project is in
# development a Word copy with the same content is written beside it, so the
# wording can be reviewed. Set to off to produce the PDF alone.
PROCURECHECK_WORD_COPY=on

# Corpus search (python run.py index / search). The embedding model runs in the
# same Ollama server as the chat model.
PROCURECHECK_EMBEDDING_MODEL=nomic-embed-text
PROCURECHECK_INDEX_DIR=knowledge/index
PROCURECHECK_RETRIEVAL_MIN_COSINE=0.65
